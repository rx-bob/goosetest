namespace consumer_formatter_test;

import goosetest;
import test_support.contracts;

fn test_statement_blocks(t: goosetest::Test&) {
    consumer_contracts::expect_format(t, "fn f(){let v,ok=parse_int(s);for x,i in xs{return x,i,1;}}",
        "fn f() {\n    let v, ok = parse_int(s);\n    for x, i in xs {\n        return x, i, 1;\n    }\n}\n");
    consumer_contracts::expect_fragment(t, "fn f(){if ok{return 1,2;}else if other{return 3,4;}else{return 5,6;}}",
        "} else if other {");
    consumer_contracts::expect_fragment(t, "fn f(){guard ok else{return 1,2;}while ok {return 3,4;}loop{break;}}",
        "return 3, 4;");
    consumer_contracts::expect_fragment(t, "struct Pair{a:i32,b:i32}", "    a: i32,\n    b: i32");
    consumer_contracts::expect_fragment(t, "fn f(){let p=Pair{a:1,b:2};}", "        a: 1,\n        b: 2");
    consumer_contracts::expect_fragment(t, "fn f(){match p {A=>1,B=>2,}}", "        A => 1,\n        B => 2,");
}
