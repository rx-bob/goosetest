// A consumer may import the package without calling any assertion vocabulary.
import goosetest from "./package";

fn main() {
    var cases: goosetest::CaseResult[>..] = [];
    var failures: goosetest::Failure[>..] = [];
    var diagnostics: u8[>..] = [];
    var metadata: u8[>..] = [];
    var results = goosetest::new_results(cases, failures, diagnostics, metadata);
    var t = goosetest::Test { results: results, .. };
    assert(goosetest::run_status(results) == 2);
}
